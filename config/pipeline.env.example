# Copy to scripts/.env for daily_pipeline.sh, or export variables in your shell.
# Use absolute paths: launchd does not expand '~'.

# Output and scheduling behavior
MUSIC_VIDEO_ROOT=/Users/YOURNAME/Desktop/music-video
LANGS="zh en"
THEME="阳光、希望、成长、幸福与欢乐"
# DATE=2026-11-10
# RETENTION_DAYS=3
# NOTIFY_FAILURE=1

# Use the project virtualenv so launchd finds the same Python dependencies.
PYTHON=/Users/YOURNAME/Desktop/music-video/.venv/bin/python3
BLENDER=/Applications/Blender.app/Contents/MacOS/Blender

# YoVoice local service
YOVOICE_HOST=127.0.0.1
YOVOICE_PORT=8080
# YOVOICE_API_BASE=http://127.0.0.1:8080
YOVOICE_DATA_DIR=/Users/YOURNAME/Desktop/music-video/.yovoice-data
YOVOICE_TOKEN_FILE=/Users/YOURNAME/Desktop/music-video/.yovoice-token
# Leave unset to auto-select an installed ACE-Step model.
# YOVOICE_MODEL_ID=ace-step-1.5-turbo-q8
# Prefer the token file over putting secrets in this file.
# YOVOICE_API_TOKEN=

# Optional generation/render tuning
# LYRICS_ATTEMPTS=5
# RENDER_SAMPLES=64
